{
  "name": "artemis-2.1",
  "version": "1.0.0",
  "description": "Space Blockchain smart contract bot for Ethereum mainnet",
  "main": "index.js",
  "scripts": {
    "postinstall": "node scripts/apply-dev-patches.cjs",
    "compile": "hardhat build",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network mainnet",
    "audit": "npm audit",
    "audit:report": "python audit-reports/generate_audit_report.py"
  },
  "keywords": [
    "ethereum",
    "smart-contracts",
    "blockchain",
    "hardhat",
    "bot"
  ],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "4.2.2",
    "@nomicfoundation/hardhat-mocha": "4.0.1",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "4.0.0",
    "@nomicfoundation/hardhat-zod-utils": "3.0.8",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "chai": "6.3.0",
    "hardhat": "3.21.2",
    "mocha": "12.0.3",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "ethers": "^6.14.0"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.3",
    "tmp": "0.2.7",
    "zod": "$zod"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  }
}
